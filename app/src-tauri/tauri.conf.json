{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MiWiFi Recovery",
  "version": "0.1.0",
  "identifier": "io.github.esdedev.miwifi-recovery",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "MiWiFi Recovery",
        "width": 1040,
        "height": 720,
        "minWidth": 900,
        "minHeight": 640,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Esdedev",
    "category": "Utility",
    "shortDescription": "Open-source recovery tool for Xiaomi routers",
    "license": "GPL-3.0-or-later",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libcap2-bin"
        ],
        "postInstallScript": "linux/postinst.sh"
      }
    }
  }
}
